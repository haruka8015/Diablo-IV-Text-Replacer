{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "拡張機能: 配布用ZIPを作成",
      "type": "process",
      "command": "python",
      "windows": {
        "command": "${env:APPDATA}/uv/python/cpython-3.10-windows-x86_64-none/python.exe"
      },
      "args": ["${workspaceFolder}/tools/build_extension.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
